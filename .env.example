# Copia este fichero a .env y rellena lo tuyo. El .env nunca se sube al repo.

# --- IA ---------------------------------------------------------------------
LLM_BACKEND=gemini                    # gemini | ollama
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Alternativa 100% local: nada sale de tu maquina
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Reintentos ante 429 (capa gratuita). 0 para desactivarlos.
LLM_REINTENTOS=6
LLM_ESPERA_MAX=90

# --- Trello -----------------------------------------------------------------
# Sin listas de 'hecho': no se calculan porcentajes. Lo que cuenta es lo
# que ponga en las subtareas, y de interpretarlo se encarga el modelo.
# La clave NO es secreta (va en el codigo de cliente de cualquier Power-Up).
# El token SI: autentica como tu y abre todos tus tableros.
# https://trello.com/power-ups/admin -> crear Power-Up -> Clave de API -> token
TRELLO_KEY=
TRELLO_TOKEN=

# --- Discord ----------------------------------------------------------------
# https://discord.com/developers/applications -> Bot -> Reset Token
# IMPRESCINDIBLE activar MESSAGE CONTENT INTENT o el bot lee mensajes vacios.
DISCORD_BOT_TOKEN=
DISCORD_BACKFILL=1000

# --- Slack (alternativa al chat) --------------------------------------------
# Token xoxb- con scopes: channels:history, channels:read, users:read
SLACK_BOT_TOKEN=

# --- Actas de reunión --------------------------------------------------------
# Whisper corre en local: el audio no sale de tu maquina.
# Modelos: tiny | base | small | medium | large-v3  (small va bien en español)
WHISPER_MODEL=small
WHISPER_IDIOMA=es       # o 'auto' para detectarlo por tramo
WHISPER_COMPUTE=int8
# Nombres propios que Whisper no puede adivinar: personas, clientes, siglas.
# Los proyectos y empresas del tablero se anaden solos desde el indice.
WHISPER_VOCABULARIO=

# Motor de transcripcion: local | groq
# Groq sirve whisper-large-v3-turbo gratis (28.800 s de audio al dia, ~220x
# tiempo real). Local es mas lento pero el audio no sale de tu maquina.
STT_BACKEND=local
GROQ_API_KEY=            # gratis y sin tarjeta: https://console.groq.com/keys
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_MINUTOS_TROZO=10     # Groq no admite ficheros de mas de 25 MB
# Whisper se inventa frases sobre el silencio del final. Se descartan los
# segmentos de la cola cuya verosimilitud sea peor que la mediana menos esto.
STT_MARGEN_ALUCINACION=0.35
# Id del canal #actas: en Discord, Ajustes > Avanzado > Modo desarrollador,
# luego clic derecho en el canal > Copiar ID.
DISCORD_ACTAS_CANAL=
# Canal del resumen en prosa: lo que el acta, con sus cuatro cajas, tiraria.
DISCORD_RESUMENES_CANAL=

# Carpeta donde OBS deja las grabaciones. `askhub.py acta` sin argumentos
# coge de ahi la pendiente mas reciente.
GRABACIONES_DIR=
# Quien habla en cada pista, por orden. OBS: pista 1 = audio del escritorio
# (la otra persona), pista 2 = tu microfono.
ACTA_HABLANTES=
# La transcripcion se guarda siempre, pero no se indexa: el resumen en prosa
# ya recoge las ideas, y la paja indexada compite con lo bueno al buscar.
# Pon 1 si prefieres que entre entera.
INDEXAR_TRANSCRIPCIONES=0

# --- Bot de #preguntar -------------------------------------------------------
# Canal donde el bot escucha y responde. Ahi no se archiva nada: se pregunta.
DISCORD_PREGUNTAR_CANAL=
BOT_INTERVALO=5          # segundos entre sondeos
BOT_SYNC_MINUTOS=15      # sync automatico; 0 lo desactiva

# --- Agrupado de conversaciones ---------------------------------------------
# Un mensaje suelto ("si, dale") no vale como fragmento. Se agrupan los
# mensajes seguidos: se corta al pasar este silencio, o este tamano.
DISCORD_VENTANA_MINUTOS=1440   # 24h: en chat de trabajo se contesta tarde
DISCORD_VENTANA_CHARS=1500

# --- Custodia: los tres cables de integracion (docs/INTEGRATION.md) ----------
# askhub no corre sin un actor con nombre: quien lanza el comando.
CUSTODIA_ACTOR=
# Libro de custodia: una linea JSON por llamada a un modelo (o - para stdout).
CUSTODIA_LEDGER=logs/custody.jsonl
# Clave local para firmar un acta con tools/signoff.py; la empresa la sustituye por su PKI.
CUSTODIA_SIGNING_KEY=
